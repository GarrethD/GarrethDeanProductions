---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterSignup from "../components/NewsletterSignup";
---

<BaseLayout
  title="Newsletter | GD Productions"
  description="Join the GD Productions newsletter for game updates and news."
  path="/newsletter"
>
  <section class="newsletter-page">
    <div>
      <p class="eyebrow">Newsletter</p>
      <h1>Get game updates.</h1>
      <p>Join the newsletter for news about Cloaked Protocol, Augment Protocol, trailers, and release dates.</p>
    </div>
    <div class="newsletter-card">
      <NewsletterSignup client:load />
    </div>
  </section>
</BaseLayout>
