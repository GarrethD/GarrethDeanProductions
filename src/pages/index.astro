---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredGames } from "../data/site";
---

<BaseLayout
  title="GD Productions | Cloaked Protocol & Augment Protocol"
  description="GD Productions is developing Cloaked Protocol and Augment Protocol."
  path="/"
>
  <section class="home-hero">
    <div class="home-hero__media">
      <img src="/assets/images/CloakedprotocolPromoImage2.png" alt="" />
      <video autoplay muted loop playsinline aria-hidden="true"><source src="/assets/videos/fog.webm" type="video/webm" /></video>
    </div>
    <div class="home-hero__content">
      <p class="eyebrow">Games</p>
      <h1>Games built<br /><em>with purpose.</em></h1>
      <p class="home-hero__intro">
        Action games set in a connected universe.
      </p>
      <div class="cta-row">
        <a class="button button--primary" href="/games">View the games <span>↗</span></a>
        <a class="button button--ghost" href="/newsletter">Get updates</a>
      </div>
    </div>
    <div class="home-hero__index">
      <span>Now developing</span>
      <strong>Cloaked Protocol</strong>
      <span>PC / Steam</span>
    </div>
  </section>

  <section class="section">
    <header class="section-head section-head--split">
      <div><p class="eyebrow">Current projects</p><h2>The games.</h2></div>
      <a class="text-link" href="/games">View all games ↗</a>
    </header>

    <div class="project-bento">
      {featuredGames.map((game, index) => (
        <article class="project-tile">
          <img src={game.image} alt="" />
          <div class="project-tile__wash"></div>
          <div class="project-tile__top">
            <span class="chip">{game.status}</span>
            <span class="eyebrow">Project / 0{index + 1}</span>
          </div>
          <div class="project-tile__body">
            <img class="project-tile__logo" src={game.logo} alt={game.title} />
            <p>{game.summary}</p>
            <a class="text-link" href={game.primaryCta.href}>Wishlist on Steam ↗</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="studio-strip">
    <div><p class="eyebrow">The universe</p><h2>Connected games.<br />One shared universe.</h2></div>
    <p>
      Cloaked Protocol focuses on stealth, espionage, and infiltration. Augment Protocol brings faster combat and
      replayable missions to the same world.
    </p>
    <a class="button button--ghost" href="/company">About the studio ↗</a>
  </section>

  <section class="dispatch">
    <div><p class="eyebrow">Newsletter</p><h2>Keep up with development.</h2></div>
    <p>Join the newsletter for game updates, trailers, and release news.</p>
    <a class="button button--primary" href="/newsletter">Join the newsletter <span>↗</span></a>
  </section>
</BaseLayout>
