---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | GD Productions"
  description="About GD Productions and the games currently in development."
  path="/company"
>
  <section class="page-hero">
    <p class="eyebrow">About</p>
    <h1>About the studio.</h1>
    <p>
      Cloaked Protocol and Augment Protocol share a world built around espionage, advanced technology, and covert conflict.
    </p>
  </section>

  <section class="about-grid">
    <img src="/assets/images/Jack.jpg" alt="Character artwork from Cloaked Protocol" />
    <div>
      <p class="eyebrow">The games</p>
      <h2>Stealth and action in one connected universe.</h2>
      <p>
        Cloaked Protocol is a third-person stealth action thriller. Augment Protocol is a faster action game focused on
        combat and replayable missions. Each project explores a different side of the same world.
      </p>
      <a class="button button--primary" href="/games">View the games ↗</a>
    </div>
  </section>
</BaseLayout>
