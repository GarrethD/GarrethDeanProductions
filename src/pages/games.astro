---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredGames } from "../data/site";
---

<BaseLayout
  title="Games | GD Productions"
  description="Cloaked Protocol and Augment Protocol, currently in development at GD Productions."
  path="/games"
>
  <section class="page-hero page-hero--games">
    <p class="eyebrow">Games</p>
    <h1>Games in development.<br />One universe.</h1>
    <p>Current projects for PC and Steam.</p>
  </section>

  <section class="game-stack">
    {featuredGames.map((game, index) => (
      <article class="game-feature">
        <div class="game-feature__media">
          <img src={game.image} alt={`${game.title} artwork`} />
          <video autoplay muted loop playsinline aria-hidden="true"><source src={game.video} type="video/webm" /></video>
        </div>
        <div class="game-feature__content">
          <div class="game-feature__meta">
            <span class="eyebrow">Project / 0{index + 1}</span>
            <span class="chip">{game.status}</span>
          </div>
          <img class:list={["game-feature__logo", index === 0 && "game-feature__logo--cloaked"]} src={game.logo} alt={game.title} />
          <p class="game-feature__summary">{game.summary}</p>
          <dl>
            <div><dt>Platform</dt><dd>{game.platforms}</dd></div>
          </dl>
          <div class="cta-row">
            <a class="button button--primary" href={game.primaryCta.href}>Wishlist on Steam <span>↗</span></a>
            <a class="button button--ghost" href="/newsletter">Get updates</a>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
