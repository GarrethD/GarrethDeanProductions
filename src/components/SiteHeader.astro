---
import { navItems } from "../data/site";

const { currentPath } = Astro.props;
---

<header class="site-header">
  <a href="/" class="brand">
    <span class="brand__mark">GD</span>
    <span>
      <span class="brand__name">GD Productions</span>
    </span>
  </a>

  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span></span>
    <span></span>
  </button>

  <nav id="site-nav" class="site-nav" aria-label="Primary">
    {
      navItems.map((item) => (
        <a href={item.href} class={currentPath === item.href ? "is-active" : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <a class="header-cta" href="/newsletter">Get updates <span aria-hidden="true">↗</span></a>
</header>
